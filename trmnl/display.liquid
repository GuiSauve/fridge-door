{% if display and display != "" %}{% assign body = display %}{% else %}{% assign body = text %}{% endif %}
<div class="layout layout--top layout--left" style="align-items: stretch;">
  <div style="display: flex; width: 100%; height: 100%; gap: 28px;">
    <div class="fo-col" style="flex: 1; min-width: 0; overflow: hidden;"><div class="fo-fit">
      {% if week and week.size > 0 %}
        {% for d in week %}
          <div class="title title--small" style="{% unless forloop.first %}margin-top: 0.75em;{% endunless %}">{% if d.today %}Today · {% endif %}{{ d.label }}</div>
          {% if d.events.size == 0 %}<div class="content">Nothing planned</div>{% endif %}
          {% for e in d.events %}<div class="content">{% if e.time and e.time != "" %}{{ e.time }} &nbsp;{% endif %}{{ e.title }}</div>{% endfor %}
        {% endfor %}
      {% else %}
        <div class="title title--small">Today · {% if today and today != "" %}{{ today }}{% else %}{{ trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: "%A %-d %b" }}{% endif %}</div>
        <div class="content">Calendar arrives with the next update</div>
      {% endif %}
    </div></div>
    <div style="width: 2px; background: #000;"></div>
    <div class="fo-col" style="flex: 1; min-width: 0; overflow: hidden;"><div class="fo-fit">
      <div id="fo-digest" class="content" data-sent="{{ sent_at | escape }}" style="white-space: pre-line;">{{ body | strip | escape }}</div>
      {% if quote and quote != "" %}<div class="description" style="margin-top: 1.4em; padding-top: 0.6em; border-top: 1px solid #000; font-style: italic;">“{{ quote | escape }}”{% if quote_by and quote_by != "" %} — {{ quote_by | escape }}{% endif %}</div>{% endif %}
    </div></div>
  </div>
</div>
<div class="title_bar">
  <span class="title">Family</span>
  <span class="instance">{% if trmnl.device.percent_charged %}🔋 {{ trmnl.device.percent_charged | round }}%{% endif %}</span>
</div>
<script>
  // Digest column: one <div> per line; first line becomes "📋 Digest · <sent_at>",
  // lines ending with ":" are section titles (TRMNL's bold "title title--small").
  (function () {
    var NL = String.fromCharCode(10);
    var el = document.getElementById("fo-digest");
    if (!el) return;
    var lines = el.textContent.split(NL);
    el.style.whiteSpace = "normal";
    el.textContent = "";
    var first = true;
    lines.forEach(function (line) {
      var t = line.trim();
      if (!t) return;
      var d = document.createElement("div");
      if (first && el.getAttribute("data-sent")) { t = "📋 Digest · " + el.getAttribute("data-sent"); }
      d.textContent = t;
      var isHead = first || /:$/.test(t);
      if (isHead) { d.className = "title title--small"; }
      if (isHead && !first) d.style.marginTop = "0.75em";
      el.appendChild(d);
      first = false;
    });
  })();
  // Auto-fit: each column starts at 125% and shrinks in 5% steps until its content fits (min 85%).
  (function () {
    var cols = document.querySelectorAll(".fo-col");
    for (var i = 0; i < cols.length; i++) {
      var col = cols[i], fit = col.querySelector(".fo-fit");
      if (!fit) continue;
      var z = 1.25;
      fit.style.zoom = z;
      while (z > 0.85 && fit.getBoundingClientRect().height > col.getBoundingClientRect().height) {
        z = Math.round((z - 0.05) * 100) / 100;
        fit.style.zoom = z;
      }
    }
  })();
</script>
