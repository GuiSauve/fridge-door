{% if display and display != "" %}{% assign body = display %}{% else %}{% assign body = text %}{% endif %}<div class="layout layout--col layout--top layout--left">
  <div class="richtext richtext--left">
    <div id="fo-digest" class="content" style="white-space: pre-line;">{{ body | strip | escape }}</div>
  </div>
</div>
<div class="title_bar">
  <span class="title">Family digest</span>
  <span class="instance">{{ sent_at }}</span>
</div>
<script>
  // One <div> per line: the first line and lines ending with ":" are section
  // titles, shown in TRMNL's bold "title title--small" style (plain font-weight
  // has no effect with the TRMNL font). Empty lines are dropped; titles get space above.
  (function () {
    var NL = String.fromCharCode(10);
    var el = document.getElementById("fo-digest");
    if (!el) return;
    var lines = el.textContent.split(NL);
    el.style.whiteSpace = "normal";
    el.textContent = "";
    var first = true;
    lines.forEach(function (line) {
      var t = line.trim();
      if (!t) return;
      var d = document.createElement("div");
      d.textContent = t;
      var isHead = first || /:$/.test(t);
      if (isHead) { d.className = "title title--small"; }
      if (isHead && !first) d.style.marginTop = "0.7em";
      el.appendChild(d);
      first = false;
    });
  })();
</script>
